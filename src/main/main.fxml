<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="730.0" prefWidth="1201.0" style="-fx-background-color: #0a0833;" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.MainController">
    <stylesheets>
        <URL value="@main.css" />
    </stylesheets>
    <left>
        <VBox fx:id="navBar" prefHeight="730.0" prefWidth="200.0" styleClass="nav-sidebar" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" translateX="70.0" translateY="20.0">
                    <image>
                        <Image url="@../images/Bank%20Logo%202.png" />
                    </image>
                </ImageView>
                <Label styleClass="nav-title" text="Bank Management" textAlignment="CENTER" translateX="25.0" translateY="35.0">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label styleClass="nav-section-label" text="MENU" translateY="70.0">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
                <Button fx:id="btnDashboard" onAction="#handleDashboardClick" styleClass="nav-btn, nav-btn-active" text="Dashboard" translateY="80.0">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/icons8_Home_32px.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="btnAccountManagement" onAction="#handleAccountManagementClick" styleClass="nav-btn" text="Account Management" translateY="90.0">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/icons8-base-de-données-50%20(12).png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <VBox alignment="BOTTOM_CENTER" prefHeight="300.0" translateY="100.0">
                    <children>
                        <Button onAction="#handleClose" styleClass="close-btn" text="Close">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/icons8-multiplier-30.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>
    <center>
        <AnchorPane fx:id="contentArea" prefHeight="730.0" prefWidth="1001.0" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
