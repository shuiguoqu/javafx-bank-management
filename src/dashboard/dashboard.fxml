<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="730.0" prefWidth="1201.0" style="-fx-background-color: #0a0833;" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dashboard.DashboardController">
    <stylesheets>
        <URL value="@dashboard.css" />
    </stylesheets>
   <children>
      <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="730.0" prefWidth="1201.0">
         <children>
            <AnchorPane fx:id="contentArea" layoutX="200.0" layoutY="0.0" prefHeight="730.0" prefWidth="1001.0" style="-fx-background-color: #f2f2f2;">
               <children>
                  <Label layoutX="40.0" layoutY="30.0" styleClass="page-title" text="📊 Dashboard">
                     <font>
                        <Font size="28.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER" layoutX="40.0" layoutY="80.0" prefHeight="120.0" prefWidth="920.0" spacing="20.0">
                     <children>
                        <VBox fx:id="card1" alignment="CENTER" prefHeight="120.0" prefWidth="215.0" styleClass="stat-card">
                           <children>
                              <Label styleClass="card-icon" text="🏦">
                                 <font>
                                    <Font size="32.0" />
                                 </font>
                              </Label>
                              <Label styleClass="card-title" text="Total Accounts">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="totalAccountsLabel" styleClass="card-value" text="0">
                                 <font>
                                    <Font size="28.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox fx:id="card2" alignment="CENTER" prefHeight="120.0" prefWidth="215.0" styleClass="stat-card">
                           <children>
                              <Label styleClass="card-icon" text="🏛️">
                                 <font>
                                    <Font size="32.0" />
                                 </font>
                              </Label>
                              <Label styleClass="card-title" text="Bank Count">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="bankCountLabel" styleClass="card-value" text="0">
                                 <font>
                                    <Font size="28.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox fx:id="card3" alignment="CENTER" prefHeight="120.0" prefWidth="215.0" styleClass="stat-card">
                           <children>
                              <Label styleClass="card-icon" text="💰">
                                 <font>
                                    <Font size="32.0" />
                                 </font>
                              </Label>
                              <Label styleClass="card-title" text="Total Balance">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="totalBalanceLabel" styleClass="card-value" text="0">
                                 <font>
                                    <Font size="28.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox fx:id="card4" alignment="CENTER" prefHeight="120.0" prefWidth="215.0" styleClass="stat-card">
                           <children>
                              <Label styleClass="card-icon" text="📈">
                                 <font>
                                    <Font size="32.0" />
                                 </font>
                              </Label>
                              <Label styleClass="card-title" text="Average Balance">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="avgBalanceLabel" styleClass="card-value" text="0">
                                 <font>
                                    <Font size="28.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <VBox layoutX="40.0" layoutY="230.0" prefHeight="460.0" prefWidth="920.0" styleClass="chart-container">
                     <children>
                        <Label styleClass="chart-title" text="Accounts Distribution by Bank">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                        <BarChart fx:id="barChart" prefHeight="420.0" prefWidth="900.0" styleClass="bar-chart">
                          <xAxis>
                            <CategoryAxis label="Bank Name" side="BOTTOM" fx:id="xAxis" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis fx:id="yAxis" label="Account Count" side="LEFT" />
                          </yAxis>
                        </BarChart>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
