<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dashboard.DashboardController">
   <center>
      <VBox alignment="TOP_CENTER" spacing="30.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <VBox alignment="CENTER" styleClass="stat-card" spacing="10.0">
                     <children>
                        <Label styleClass="card-icon" text="📊" />
                        <Label styleClass="card-label" text="账户总数" />
                        <Label fx:id="totalAccountsLabel" styleClass="card-value" text="0">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" styleClass="stat-card" spacing="10.0">
                     <children>
                        <Label styleClass="card-icon" text="🏦" />
                        <Label styleClass="card-label" text="银行数量" />
                        <Label fx:id="bankCountLabel" styleClass="card-value" text="0">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" styleClass="stat-card" spacing="10.0">
                     <children>
                        <Label styleClass="card-icon" text="💰" />
                        <Label styleClass="card-label" text="总余额" />
                        <Label fx:id="totalBalanceLabel" styleClass="card-value" text="0">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" styleClass="stat-card" spacing="10.0">
                     <children>
                        <Label styleClass="card-icon" text="📈" />
                        <Label styleClass="card-label" text="平均余额" />
                        <Label fx:id="averageBalanceLabel" styleClass="card-value" text="0.00">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label styleClass="chart-title" text="各银行账户数分布">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>
                  <BarChart fx:id="bankBarChart" prefHeight="400.0" prefWidth="800.0" styleClass="bar-chart">
                    <xAxis>
                      <CategoryAxis fx:id="xAxis" label="银行名称" />
                    </xAxis>
                    <yAxis>
                      <NumberAxis fx:id="yAxis" label="账户数量" />
                    </yAxis>
                  </BarChart>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
